<?xml version="1.0" encoding="utf-8"?>
<!-- Google TV-style home. 1080p TVs at density 320 are 960 x 540 dp; sizes are measured off the stock launcher. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Two photo layers crossfade; the scrim keeps text readable over them. -->
    <ImageView
        android:id="@+id/photo_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/photo_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <view
            class="tv.cleanhome.gtv.MainActivity$CenterScroll"
            android:id="@+id/home_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </view>

        <ScrollView
            android:id="@+id/apps_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="100dp"
            android:paddingBottom="48dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/apps_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="50dp"
                android:paddingEnd="50dp" />
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="58dp"
        android:paddingEnd="58dp">

        <LinearLayout
            android:id="@+id/nav_pill"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView android:id="@+id/tab_home" style="@style/PillIcon"
                android:contentDescription="@string/tab_home" android:src="@drawable/ic_home" />
            <ImageView android:id="@+id/tab_apps" style="@style/PillIcon"
                android:contentDescription="@string/tab_apps" android:src="@drawable/ic_apps" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_pill"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView android:id="@+id/btn_inputs" style="@style/PillIcon"
                android:contentDescription="@string/action_inputs" android:src="@drawable/ic_input" />
            <ImageView android:id="@+id/btn_screensaver" style="@style/PillIcon"
                android:contentDescription="@string/action_screensaver" android:src="@drawable/ic_frame" />
            <ImageView android:id="@+id/btn_quick" style="@style/PillIcon"
                android:contentDescription="@string/action_quick_settings" android:src="@drawable/ic_settings_arrow" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:textColor="#C4C7C5"
            android:textSize="19sp" />

        <View
            android:id="@+id/weather_divider"
            android:layout_width="2dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="#C4C7C5" />

        <TextView
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#C4C7C5"
            android:textSize="19sp" />
    </LinearLayout>

    <!-- Label under the focused screensaver / quick settings button. -->
    <TextView
        android:id="@+id/tooltip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="invisible" />
</FrameLayout>
